<?xml version="1.0" encoding="UTF-8"?>
<advancedsettings>
  <video>
    <adjustrefreshrate>
      <override>
        <fpsmin>23.966</fpsmin>
        <fpsmax>23.986</fpsmax>
        <refreshmin>23.966</refreshmin>
        <refreshmax>23.986</refreshmax>
      </override>
      <override>
        <fpsmin>24.0</fpsmin>
        <fpsmax>24.0</fpsmax>
        <refreshmin>24.0</refreshmin>
        <refreshmax>24.0</refreshmax>
      </override>
      <override>
        <fpsmin>29.966</fpsmin>
        <fpsmax>29.986</fpsmax>
        <refreshmin>29.966</refreshmin>
        <refreshmax>29.986</refreshmax>
      </override>
      <override>
        <fpsmin>50.0</fpsmin>
        <fpsmax>50.0</fpsmax>
        <refreshmin>50.0</refreshmin>
        <refreshmax>50.0</refreshmax>
      </override>
    </adjustrefreshrate>
    <displaylatency>100</displaylatency>
    <!-- Added to Kodi's own: a title ends at a season tag, so a show folder
         named "Pantheon.S01.1080p.WEBRip" is looked up as "Pantheon". -->
    <cleanstrings action="append">
      <regexp>[ _\,\.\(\)\[\]\-](s[0-9]{1,2}(e[0-9]{1,3})?|season[ _\.]?[0-9]{1,2})([ _\,\.\(\)\[\]\-]|$)</regexp>
    </cleanstrings>
  </video>

  <cache>
    <memcachesize>256</memcachesize>
    <readfactor>4.0</readfactor>
  </cache>

  <videolibrary>
    <updateonstartup>true</updateonstartup>
    <cleanonupdate>true</cleanonupdate>
    <scanonstartup>true</scanonstartup>
  </videolibrary>

  <musiclibrary>
    <updateonstartup>true</updateonstartup>
    <scanonstartup>true</scanonstartup>
  </musiclibrary>
</advancedsettings>
