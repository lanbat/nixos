# secrets/secrets.nix.example
#
# agenix recipients configuration — maps each .age secret to the public keys
# that can decrypt it.
#
# HOW TO USE
# ----------
# 1. Copy this file:
#      cp secrets/secrets.nix.example secrets/secrets.nix
#    secrets/secrets.nix is gitignored — never commit it.
#
# 2. Fill in your admin SSH public key immediately (needed before machines exist):
#      cat ~/.ssh/id_ed25519.pub
#
# 3. Fill in the host keys before each host's first boot, then re-encrypt:
#      server:     the key you create for nixos-anywhere (deployment checklist step 1c)
#      pi-storage: ssh root@<pi-ip> cat /etc/ssh/ssh_host_ed25519_key.pub (step 2e)
#      pi-bedroom: same command on a voice-pi host, if you have one
#      cd secrets && agenix -r
#
# 4. Create secrets with:
#      cd secrets && agenix -e <name>.age
#    Commit the .age files — they are encrypted and safe to commit.
#
# NEVER commit secrets/secrets.nix — it contains real SSH public keys.
let
  # Host SSH public keys — map from deploy.nix hosts.* keys:
  #   server     → hosts.server
  #   pi-storage → hosts.pi-storage (storage-pi role)
  #   pi-bedroom → hosts.pi-bedroom (voice-pi role, optional)
  server     = "ssh-ed25519 CHANGE_ME_SERVER_HOST_KEY";
  pi-storage = "ssh-ed25519 CHANGE_ME_PI_STORAGE_HOST_KEY";
  pi-bedroom = "ssh-ed25519 CHANGE_ME_PI_BEDROOM_HOST_KEY"; # optional voice-pi

  # Your personal SSH public key — allows editing secrets from your workstation.
  admin = "ssh-ed25519 CHANGE_ME_ADMIN_PERSONAL_KEY";

  serverKeys    = [ server admin ];
  storagePiKeys = [ pi-storage admin ];
  voicePiKeys   = [ pi-bedroom admin ]; # only if pi-bedroom exists
  allPis        = [ pi-storage pi-bedroom ]; # drop pi-bedroom if unused
  allKeys       = serverKeys ++ allPis;
in
{
  # ---- Authentik ----
  "authentik-env.age".publicKeys          = serverKeys;
  "searxng-secret.age".publicKeys         = serverKeys;
  # Five OIDC client secrets, one per service (Grafana, Nextcloud, Immich, HA, Jellyfin).
  "authentik-oidc-secrets.age".publicKeys = serverKeys;

  # ---- Nextcloud ----
  "nextcloud-admin-pass.age".publicKeys = serverKeys;
  "nextcloud-oidc-env.age".publicKeys   = serverKeys;

  # ---- Immich ----
  "immich-db-password.age".publicKeys = serverKeys;
  "immich-oidc-env.age".publicKeys    = serverKeys;

  # ---- Frigate ----
  "frigate-rtsp-env.age".publicKeys      = serverKeys;
  "rclone-frigate-config.age".publicKeys = serverKeys;

  # ---- MQTT ----
  "mosquitto-ha-pass.age".publicKeys      = serverKeys;
  "mosquitto-frigate-pass.age".publicKeys = serverKeys;
  "mosquitto-z2m-pass.age".publicKeys     = serverKeys;

  # ---- Home Assistant ----
  # Two KEY=value lines for automated onboarding (generate-secrets.sh):
  #   OWNER_USERNAME=<value>
  #   OWNER_PASSWORD=<value>
  "hass-bootstrap-env.age".publicKeys = serverKeys;
  # One line: the API key of the LLM in lanbat.haLlm (only with haLlm set).
  "ha-llm-api-key.age".publicKeys = serverKeys;
  # The voice satellites' Home Assistant token (lanbat.voiceRooms), and its
  # record for Home Assistant. Create both with secrets/generate-ha-voice-token.sh.
  "ha-voice-token.age".publicKeys         = allKeys;
  "ha-voice-refresh-token.age".publicKeys = serverKeys;

  # Xiaomi BLE bind keys, one device per line (blank lines and # comments are
  # ignored):
  #   <MAC> <bindkey, 32 hex for MiBeacon v4/v5, 24 for v2/v3> [entry title]
  # Obtain a key locally with atc1441.github.io/Temp_universal_mi_activate.html
  # — no Xiaomi cloud account. Read by home-assistant-post-setup, only with
  # deployment.haXiaomiBle set.
  "ha-xiaomi-ble.age".publicKeys = serverKeys;

  # ---- InfluxDB ----
  "influxdb-admin-password.age".publicKeys = serverKeys;
  "influxdb-admin-token.age".publicKeys    = serverKeys;

  # ---- Grafana ----
  # File format (one KEY=value per line):
  #   GF_SECURITY_SECRET_KEY=<64-char random string>
  #   GF_SECURITY_ADMIN_PASSWORD=<break-glass admin password>
  #   GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=<from Authentik UI>
  #   INFLUXDB_TOKEN=<same value as influxdb-admin-token.age>
  "grafana-env.age".publicKeys = serverKeys;

  # ---- Telegraf ----
  # File format (one line):
  #   TELEGRAF_INFLUXDB_TOKEN=<write token for the metrics bucket>
  # Create this token in InfluxDB UI after first deploy:
  #   Data → API Tokens → Generate API Token → Write to "metrics" bucket
  "telegraf-token.age".publicKeys = allKeys;

  # ---- Bitmagnet ----
  # File format: POSTGRES_PASSWORD=<value>
  "bitmagnet-db-pass.age".publicKeys = serverKeys;

  # ---- Vaultwarden ----
  "vaultwarden-env.age".publicKeys = serverKeys;

  # ---- Homepage widgets ----
  # KEY=value lines for Homepage service widgets. Populate with:
  #   bash secrets/generate-homepage-widgets.sh
  "homepage-widgets-env.age".publicKeys = serverKeys;

  # ---- Parking guard (lanbat-justpark-parking plugin) ----
  # Optional — only when the plugin is enabled on the server.
  # justpark-api-env.age: JUSTPARK_API_KEY, JUSTPARK_USERNAME, JUSTPARK_PASSWORD, JUSTPARK_BASE_URL
  "justpark-api-env.age".publicKeys = serverKeys;
  "parking-guard-mqtt-pass.age".publicKeys = serverKeys;
  "parking-guard-notify-env.age".publicKeys = serverKeys;

  # ---- Caddy internal CA ----
  # PEM private key for the persisted root CA (public cert is secrets/caddy-ca-root.crt).
  "caddy-ca-root-key.age".publicKeys = serverKeys;
}
