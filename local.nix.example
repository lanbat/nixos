# local.nix — your deployment's settings. Not tracked by git.
#
# HOW TO USE
# ----------
# 1. cp local.nix.example local.nix
# 2. Replace every value. None of the settings have defaults, and most are
#    type-checked (IP addresses, the SSH key, USB IDs, the disk path), so a
#    missing or malformed value fails evaluation.
# 3. Refer to the flake with a path: reference, which includes this untracked
#    file. The `server` and `pi` configurations only exist when local.nix does:
#      deploy path:.#server
#      nix build path:.#nixosConfigurations.server.config.system.build.toplevel
#    A git reference such as .#server fails with "does not provide attribute".
#
# Option documentation: modules/core/settings.nix.
# Never commit local.nix: it holds your real addresses and keys.
{
  lanbat = {
    # ── Network ───────────────────────────────────────────────────────────────
    serverIp = "CHANGE_ME"; # e.g. "192.168.1.10"
    piIp = "CHANGE_ME"; # e.g. "192.168.1.11"
    gatewayIp = "CHANGE_ME"; # e.g. "192.168.1.1"
    lanSubnet = "CHANGE_ME"; # e.g. "192.168.1.0/24"

    serverHostname = "server";
    serverInterface = "CHANGE_ME"; # e.g. "enp1s0"; find with: ip -o link
    piHostname = "pi5"; # or piIp if hostname resolution is unreliable

    # ── DNS ───────────────────────────────────────────────────────────────────
    domain = "CHANGE_ME"; # e.g. "home.example.com"; *.<domain> must resolve to the server
    rootDomain = "CHANGE_ME"; # e.g. "example.com"

    # NFSv4 ID mapping domain, identical on both hosts. Any string works.
    nfsIdmapdDomain = "home.lan";

    # ── System ────────────────────────────────────────────────────────────────
    timezone = "Europe/London"; # https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
    phoneRegion = "GB"; # ISO 3166-1 alpha-2, used by Nextcloud

    # ── Home Assistant location ───────────────────────────────────────────────
    haLatitude = "51.5074";
    haLongitude = "-0.1278";
    haElevation = 11; # metres

    # ── Disks ─────────────────────────────────────────────────────────────────
    # The server's system disk. nixos-anywhere ERASES it and applies
    # hosts/server/disk.nix. From the installer: ls -l /dev/disk/by-id/
    serverDisk = "/dev/disk/by-id/CHANGE_ME";

    # The Pi's storage drives, filename only (no /dev/disk/by-id/ prefix).
    # On the Pi: ls -l /dev/disk/by-id/ | grep nvme | grep -v part
    piStorageDriveA = "CHANGE_ME"; # e.g. "nvme-Samsung_SSD_970_EVO_1TB_ABC123"
    piStorageDriveB = "CHANGE_ME";

    # ── Access ────────────────────────────────────────────────────────────────
    # Your SSH public key (cat ~/.ssh/id_ed25519.pub). deploy-rs logs in with it.
    adminSshKey = "CHANGE_ME";

    # ── Zigbee dongle (lsusb shows "ID 10c4:ea60 ...") ────────────────────────
    zigbeeVendorId = "CHANGE_ME"; # e.g. "10c4"
    zigbeeProductId = "CHANGE_ME"; # e.g. "ea60"
  };
}
