# deployments/homelab/secrets.nix.example
#
# FUTURE: per-profile agenix recipients are not wired yet. Today all profiles
# share secrets/secrets.nix at the repo root. When per-profile secrets land,
# copy this file to deployments/homelab/secrets.nix (gitignored) and set
# deployment.secretsProfile = "homelab" in your profile deploy.
#
# Until then, use secrets/secrets.nix.example and encrypt each .age file to
# the union of host keys from every profile that needs the secret.
#
# This example mirrors the root template — adjust host key variable names to
# match your deploy.nix host keys.
let
  server     = "ssh-ed25519 CHANGE_ME_SERVER_HOST_KEY";
  pi-storage = "ssh-ed25519 CHANGE_ME_PI_STORAGE_HOST_KEY";
  admin      = "ssh-ed25519 CHANGE_ME_ADMIN_PERSONAL_KEY";

  serverKeys = [ server admin ];
  allKeys    = [ server pi-storage admin ];
in
{
  "telegraf-token.age".publicKeys = allKeys;
  "ha-voice-token.age".publicKeys = allKeys;
  # …same inventory as secrets/secrets.nix.example
}
